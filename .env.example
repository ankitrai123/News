# IntelPod environment overrides (all optional). Copy to .env and edit.
# Phase 1 needs NO API keys: GDELT and RSS feeds are free and keyless.

# INTELPOD_CONFIG=config/config.yaml
# INTELPOD_DATA_DIR=data
# INTELPOD_DB_PATH=data/intelpod.db
# INTELPOD_LOG_LEVEL=INFO
# INTELPOD_LOG_JSON=false
# Identify yourself to publishers (recommended):
# INTELPOD_USER_AGENT="IntelPod/0.1 (personal news research; contact: you@example.com)"

# Ingestion
# INTELPOD_LOOKBACK_HOURS=36
# INTELPOD_FEEDS_FILE=config/feeds.yaml
# INTELPOD_RSS_ENABLED=true
# INTELPOD_GDELT_ENABLED=true

# Optional local embeddings for better clustering (requires Ollama running locally)
# INTELPOD_EMBEDDINGS_ENABLED=false
# INTELPOD_OLLAMA_URL=http://localhost:11434
# INTELPOD_EMBEDDING_MODEL=nomic-embed-text

# Future optional free-tier providers (not used in Phase 1). Anything ending in
# _KEY / _TOKEN / _SECRET is automatically redacted from logs.
# NEWSDATA_API_KEY=
# GNEWS_API_KEY=

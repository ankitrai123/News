# IntelPod environment overrides (all optional). Copy to .env and edit; .env is git-ignored.
# Nothing here is required: GDELT and RSS are keyless. The two keys below unlock free tiers.

# NewsData.io free plan (https://newsdata.io, no card): 200 credits/day, articles ~12 h delayed.
NEWSDATA_API_KEY=

# NVIDIA API Catalog free trial (https://build.nvidia.com/settings/api-keys), key starts nvapi-.
# Used for the event-review language model and for clustering embeddings. Trial terms:
# internal testing/evaluation, not production; do not publish model-written text from it.
NVIDIA_API_KEY=

# The Guardian Open Platform developer key (https://open-platform.theguardian.com/access/), free
# for non-commercial use, optional: adds date-bounded Guardian reporting/opinion to Phase 2 research.
# IntelPod requests metadata and trail text only, never article bodies.
GUARDIAN_API_KEY=

# INTELPOD_CONFIG=config/config.yaml
# INTELPOD_DATA_DIR=data
# INTELPOD_DB_PATH=data/intelpod.db
# INTELPOD_LOG_LEVEL=INFO
# INTELPOD_LOG_JSON=false
# Identify yourself to publishers (recommended):
# INTELPOD_USER_AGENT="IntelPod/0.1 (personal news research; contact: you@example.com)"

# Ingestion
# INTELPOD_LOOKBACK_HOURS=36
# INTELPOD_FEEDS_FILE=config/feeds.yaml
# INTELPOD_RSS_ENABLED=true
# INTELPOD_GDELT_ENABLED=true
# INTELPOD_NEWSDATA_ENABLED=true

# Language model (event review): nvidia (default) or ollama (local)
# INTELPOD_LLM_ENABLED=true
# INTELPOD_LLM_PROVIDER=nvidia

# Embeddings for clustering: nvidia (default, needs NVIDIA_API_KEY) or ollama (local)
# INTELPOD_EMBEDDINGS_ENABLED=true
# INTELPOD_EMBEDDINGS_PROVIDER=nvidia
# INTELPOD_OLLAMA_URL=http://localhost:11434
# INTELPOD_EMBEDDING_MODEL=nomic-embed-text

# Anything ending in _KEY / _TOKEN / _SECRET / _PASSWORD is redacted from logs.
